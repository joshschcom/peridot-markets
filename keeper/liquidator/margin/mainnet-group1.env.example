# Public configuration only. Copy to a private local env file before filling an account.
NETWORK=mainnet
GROUP_ID=1
RPC_URL=https://mainnet.sorobanrpc.com
DRY_RUN=true
RUN_ONCE=true
# A funded public account for simulation only. No secret is needed.
LIQUIDATOR_PUBLIC_KEY=
# Canonical deployment manifest is resolved automatically from the repo.
LENDING_START_LEDGER=65131405
LENDING_REPAY_CAPS_JSON='{}'
BOOSTED_REFRESH_INTERVAL_MS=120000
INTEREST_REFRESH_INTERVAL_MS=120000
MAX_TRANSACTION_FEE_STROOPS=1000000
# Intentionally unchanged. Startup estimates show this is insufficient for live group 1.
# Obtain an approved budget after reviewing the dry-run estimate; do not auto-increase.
MAX_FEE_24H_STROOPS=10000000
MIN_FEE_BALANCE_STROOPS=20000000
PORT=8788
HOST=127.0.0.1
# Empty ordinary-lending caps intentionally prevent a healthy live-coverage claim.
