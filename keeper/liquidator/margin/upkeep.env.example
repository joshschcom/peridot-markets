# Public configuration for the all-groups upkeep service (src/upkeep-main.mjs). Secrets live only in the private env file.
NETWORK=mainnet
GROUP_IDS=all
# GROUP_DENY=
RPC_URL=https://soroban-rpc.mainnet.stellar.gateway.fm
DRY_RUN=true
RUN_ONCE=true
# Dry run needs only a funded public account. Live mode additionally needs LIQUIDATOR_SECRET, DATABASE_URL, DATABASE_CA_FILE.
LIQUIDATOR_PUBLIC_KEY=
BOOSTED_REFRESH_INTERVAL_MS=120000
INTEREST_REFRESH_INTERVAL_MS=600000
DISCOVERY_INTERVAL_MS=300000
UPKEEP_MAX_TX_FEE_STROOPS=200000
MAX_TRANSACTION_FEE_STROOPS=1000000
# 10 XLM padded reservation per rolling 24 h. The measured reservation for groups 1 to 3 is about 7.74 XLM.
MAX_FEE_24H_STROOPS=100000000
MIN_FEE_BALANCE_STROOPS=20000000
PORT=8788
HOST=127.0.0.1
