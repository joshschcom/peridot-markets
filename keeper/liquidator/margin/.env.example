NETWORK=mainnet
GROUP_ID=
# Absolute path recommended. Obtain from the approved deployment script.
DEPLOYMENTS_FILE=
RPC_URL=
DRY_RUN=true
# A funded public account for RPC account reads. No secret is needed in dry-run.
LIQUIDATOR_PUBLIC_KEY=
LIQUIDATOR_SECRET=
# Only needed when live signing is approved. Never commit these values.
DATABASE_URL=
DATABASE_CA_FILE=
# Optional cross-check; authoritative hash comes from deployment manifest.
EXPECTED_CONTROLLER_WASM_HASH=
MAX_TRANSACTION_FEE_STROOPS=1000000
MAX_FEE_24H_STROOPS=10000000
MIN_FEE_BALANCE_STROOPS=20000000
BOOSTED_REFRESH_INTERVAL_MS=120000
INTEREST_REFRESH_INTERVAL_MS=120000
POLL_INTERVAL_MS=5000
PORT=8787
HOST=127.0.0.1
RUN_ONCE=false
# Required on first start: ledger at/before group creation, OR complete borrower snapshot.
LENDING_START_LEDGER=
LENDING_BOOTSTRAP_FILE=
# Explicit per-transaction repayment caps, raw integer token units as strings.
# Example format only: '{"C...verified repay market...":"1000000"}'
LENDING_REPAY_CAPS_JSON='{}'
# Net oracle-valued surplus after protocol fees, plus estimated costs in USD millionths.
# These buffers do not guarantee realized profit or receipt redemption liquidity.
LENDING_MIN_PROFIT_BPS=100
LENDING_COST_BUFFER_USD_MICRO=100000
# Defaults under persistent ./data/, scoped to network and group.
LENDING_STATE_FILE=
