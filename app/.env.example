# Mainnet is the default. Set testnet for development.
NEXT_PUBLIC_NETWORK=mainnet
# Public browser-safe provider endpoint only. Never put a private API key here.
NEXT_PUBLIC_MAINNET_RPC_URL=https://soroban-rpc.mainnet.stellar.gateway.fm
NEXT_PUBLIC_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
# Explicit local demo only. Production must be false.
NEXT_PUBLIC_USE_MOCKS=false

# Optional chain-connected preview with transactions disabled.
NEXT_PUBLIC_READ_ONLY=false
