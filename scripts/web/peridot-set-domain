#!/usr/bin/env bash
# Installed at /usr/local/bin/peridot-set-domain on the web droplet. Run as root.
#   peridot-set-domain app.example.com [testnet-host] [--no-rebuild]
#   peridot-set-domain --ip-only
# Rewrites /etc/caddy/Caddyfile and reloads Caddy. The mainnet build links to the testnet
# host (NEXT_PUBLIC_TESTNET_APP_URL is baked in at build time), so it is rebuilt unless --no-rebuild.
set -euo pipefail
[ "$(id -u)" = 0 ] || { echo "run as root (sudo peridot-set-domain ...)" >&2; exit 1; }
STATE=/etc/peridot-web/hosts.env
mkdir -p /etc/peridot-web
[ -f "$STATE" ] && . "$STATE"
IP="${IP:-$(curl -fsS4 https://ifconfig.me || hostname -I | awk '{print $1}')}"
REBUILD=1; ARGS=()
for a in "$@"; do case "$a" in --no-rebuild) REBUILD=0;; *) ARGS+=("$a");; esac; done
MAIN_HOST=""; TESTNET_HOST=""
case "${ARGS[0]:-}" in
  ""|--help|-h) sed -n '2,7p' "$0"; exit 1;;
  --ip-only) ;;
  *) MAIN_HOST="${ARGS[0]}"; TESTNET_HOST="${ARGS[1]:-testnet.${ARGS[0]}}";;
esac
if [[ -n "$MAIN_HOST" && ! "$MAIN_HOST$TESTNET_HOST" =~ ^[A-Za-z0-9.-]+$ ]]; then echo "invalid hostname" >&2; exit 1; fi
SSLIP="testnet.${IP}.sslip.io"
{ echo "IP=$IP"; echo "MAIN_HOST=$MAIN_HOST"; echo "TESTNET_HOST=$TESTNET_HOST"; } > "$STATE"
{
  echo "# Generated by peridot-set-domain. Do not edit by hand; rerun the command instead."
  echo "# Domain mode: $MAIN_HOST (mainnet) and $TESTNET_HOST (testnet). Empty means IP only."
  echo "http://$IP {"; echo "	encode zstd gzip"; echo "	reverse_proxy 127.0.0.1:3000 {"; echo "		header_up X-Forwarded-For {remote_host}"; echo "	}"; echo "}"
  echo "http://$SSLIP {"; echo "	encode zstd gzip"; echo "	reverse_proxy 127.0.0.1:3001 {"; echo "		header_up X-Forwarded-For {remote_host}"; echo "	}"; echo "}"
  if [ -n "$MAIN_HOST" ]; then
    echo "$MAIN_HOST {"; echo "	encode zstd gzip"; echo "	reverse_proxy 127.0.0.1:3000 {"; echo "		header_up X-Forwarded-For {remote_host}"; echo "	}"; echo "}"
    echo "$TESTNET_HOST {"; echo "	encode zstd gzip"; echo "	reverse_proxy 127.0.0.1:3001 {"; echo "		header_up X-Forwarded-For {remote_host}"; echo "	}"; echo "}"
  fi
} > /etc/caddy/Caddyfile.new
caddy validate --config /etc/caddy/Caddyfile.new --adapter caddyfile >/dev/null
mv /etc/caddy/Caddyfile.new /etc/caddy/Caddyfile
systemctl reload caddy
echo "Caddy reloaded. mainnet: ${MAIN_HOST:-http://$IP}  testnet: ${TESTNET_HOST:-http://$SSLIP}"
if [ "$REBUILD" = 1 ] && [ -d /opt/peridot-web/app/node_modules ]; then
  echo "Rebuilding mainnet so its testnet link points at the new host (a few minutes)..."
  /usr/local/bin/peridot-web-build mainnet
fi
if [ -n "$MAIN_HOST" ]; then echo "Check certificates: journalctl -u caddy -n 30 --no-pager"; fi
